   "events": "ended",
   "expect": {
    "state": "ended",
    "safeToRestart": false
   }
  },
  {
   "name": "ended: run.end written even though the pid is gone",
   "claim": {
    "ageMs": 1000
   },
   "events": "ended",
   "pid": "gone",
   "expect": {
    "state": "ended",
    "safeToRestart": false
   }
  },
  {
   "name": "nothing, process started 5s ago",
